# The live site address, with no trailing slash.
# Leave unset for previews: robots.txt then blocks crawlers and pages are marked noindex.
NEXT_PUBLIC_SITE_URL=https://www.example.org.uk

# WebMCP origin trial tokens, so AI agents can use the site's tools in Chrome and Edge.
# Register the live domain at:
#   Chrome: https://developer.chrome.com/origintrials/#/register_trial/4163014905550602241
#   Edge:   https://developer.microsoft.com/en-us/microsoft-edge/origin-trials/trials/0b76fe60-b266-458e-a285-04e375c0c31a
# Tokens expire: note the expiry date and renew before it.
CHROME_ORIGIN_TRIAL_TOKEN=
EDGE_ORIGIN_TRIAL_TOKEN=
